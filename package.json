{
  "name": "agentsync",
  "version": "0.1.0",
  "description": "A multi-agent collaboration hub for AI coding teams. Many humans and AI agents work on one repo from a shared plan — with file-scope claims, live chat, and MCP-native conflict warnings that keep fast agents from colliding. Zero merge conflicts.",
  "type": "module",
  "bin": {
    "agentsync": "src/cli/index.js"
  },
  "scripts": {
    "hub": "node src/cli/index.js hub",
    "mcp": "node src/mcp/server.js",
    "demo": "node scripts/demo-member.js",
    "test": "node scripts/smoke.js"
  },
  "files": [
    "src",
    "hooks",
    "agentsync.config.yaml",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "author": "Deepak (dipakkr) <dipakkr.co@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipakkr/agentsync.git"
  },
  "bugs": {
    "url": "https://github.com/dipakkr/agentsync/issues"
  },
  "homepage": "https://github.com/dipakkr/agentsync#readme",
  "keywords": [
    "ai-agents",
    "ai-coding-agents",
    "claude",
    "claude-code",
    "codex",
    "multi-agent",
    "multi-agent-collaboration",
    "multi-agent-orchestration",
    "coordination",
    "collaboration",
    "conflict-free",
    "mcp",
    "git-worktrees",
    "orchestration",
    "hackathon"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  }
}
